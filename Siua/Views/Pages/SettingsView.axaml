<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Siua.ViewModels"
 x:Class="Siua.Views.Pages.SettingsView" x:DataType="vm:SettingsViewModel">
 <Grid>
  <ScrollViewer IsVisible="{Binding IsOverview}" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24" Spacing="24">
   <StackPanel Spacing="6"><TextBlock Text="偏好设置" Classes="web-title"/><TextBlock Text="配置浏览器、文字识别与答题偏好。修改会自动保存。" Classes="web-muted"/></StackPanel>
   <Border Classes="panel"><Grid ColumnDefinitions="210,*" ColumnSpacing="40">
    <StackPanel Spacing="8"><TextBlock Text="浏览器" Classes="web-section"/><TextBlock Text="登录平台和执行课程任务时使用的浏览器。" Classes="web-muted"/></StackPanel>
    <StackPanel Grid.Column="1" Spacing="18">
     <Grid ColumnDefinitions="*,180"><TextBlock Text="自动化浏览器" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Browsers}" SelectedItem="{Binding CurrentBrowser}" HorizontalAlignment="Stretch"/></Grid>
     <Border Height="1" Background="{DynamicResource WebBorder}"/>
     <Grid ColumnDefinitions="*,Auto"><TextBlock Text="当前平台" Classes="web-muted" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Settings.CurrentPlatform}" Foreground="{DynamicResource WebAccent}"/></Grid>
     <StackPanel Orientation="Horizontal" Spacing="10"><Button Classes="web" Content="管理课程" Command="{Binding ShowCourseListCommand}"/><Button Classes="web" Content="管理账号" Command="{Binding ShowAccountListCommand}"/></StackPanel>
    </StackPanel>
   </Grid></Border>
   <Border Classes="panel"><Grid ColumnDefinitions="210,*" ColumnSpacing="40">
    <StackPanel Spacing="8"><TextBlock Text="文字识别" Classes="web-section"/><TextBlock Text="Pix2Text 本地服务的监听与连接设置。" Classes="web-muted"/></StackPanel>
    <StackPanel Grid.Column="1" Spacing="18">
     <Grid ColumnDefinitions="*,140" ColumnSpacing="18"><StackPanel Spacing="7"><TextBlock Text="监听地址" Classes="web-label"/><TextBox Text="{Binding Settings.Pix2TextHost}" PlaceholderText="127.0.0.1"/></StackPanel><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="监听端口" Classes="web-label"/><TextBox Text="{Binding Settings.Pix2TextPort}" PlaceholderText="8503"/></StackPanel></Grid>
     <TextBlock Text="{Binding Pix2TextEndpointDescription}" Classes="web-muted"/>
     <TextBlock Text="支持 IPv4 与 IPv6。安装、启动和停止服务位于工作台的「执行策略」页签。" Classes="web-muted"/>
    </StackPanel>
   </Grid></Border>
   <Border Classes="panel"><Grid ColumnDefinitions="210,*" ColumnSpacing="40">
    <StackPanel Spacing="8"><TextBlock Text="答题偏好" Classes="web-section"/><TextBlock Text="调整 AI 请求间隔与题目截图方式。" Classes="web-muted"/></StackPanel>
    <StackPanel Grid.Column="1" Spacing="18">
     <Grid ColumnDefinitions="*,150"><StackPanel Spacing="5"><TextBlock Text="请求间隔"/><TextBlock Text="单位 ms，按服务商限制设置" Classes="web-muted"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Settings.AiAnsweringInterval}" TextAlignment="Center"/></Grid>
     <Border Height="1" Background="{DynamicResource WebBorder}"/>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="5"><TextBlock Text="整份章节测试截图"/><TextBlock Text="开启后一次截图、批量答题；关闭时逐题处理。" Classes="web-muted"/></StackPanel><ToggleButton Grid.Column="1" Classes="Switch" IsChecked="{Binding Settings.RegionScreenshot}" VerticalAlignment="Center"/></Grid>
     <Border Height="1" Background="{DynamicResource WebBorder}"/>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><StackPanel Spacing="5"><TextBlock Text="当前模型" Classes="web-muted"/><TextBlock Text="{Binding Settings.CurrentAi.ModelName, TargetNullValue=尚未配置}"/></StackPanel><Button Grid.Column="1" Classes="web" Content="配置模型" Command="{Binding ShowAiSettingCommand}"/></Grid>
    </StackPanel>
   </Grid></Border>
  </StackPanel></ScrollViewer>
  <ContentControl IsVisible="{Binding IsSubPageOpen}" Content="{Binding ActiveSubPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 </Grid>
</UserControl>