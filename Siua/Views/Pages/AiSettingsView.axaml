<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Siua.ViewModels" xmlns:co="using:Siua.Common" xmlns:suki="https://github.com/kikipoulet/SukiUI"
 x:Class="Siua.Views.Pages.AiSettingsView" x:DataType="vm:AiSettingsViewModel">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,24" Spacing="24">
  <StackPanel Spacing="6"><TextBlock Text="AI 模型" Classes="web-title"/><TextBlock Text="连接模型服务，为课程答题提供分析能力。" Classes="web-muted"/></StackPanel>
  <suki:InfoBar Message="{Binding ConnectionInfoMessage}" co:InfoBarExtensions.Severity="{Binding ConnectionInfoSeverity}" IsClosable="True" IsOpen="{Binding IsConnectionInfoOpen, Mode=TwoWay}" IsVisible="{Binding IsConnectionInfoOpen}"/>
  <Border Classes="panel">
   <Grid ColumnDefinitions="230,*" ColumnSpacing="40">
    <StackPanel Spacing="9"><TextBlock Text="模型连接" Classes="web-section"/><TextBlock Text="选择服务商并填写连接信息。修改会自动保存到本机。" Classes="web-muted"/><Border Classes="badge" HorizontalAlignment="Left" Margin="0,8,0,0"><TextBlock Text="支持自定义兼容接口" FontSize="11" Foreground="{DynamicResource WebAccent}"/></Border></StackPanel>
    <StackPanel Grid.Column="1" Spacing="20" MaxWidth="560" HorizontalAlignment="Stretch">
     <StackPanel Spacing="7"><TextBlock Text="服务商" Classes="web-label"/><ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" HorizontalAlignment="Stretch"/></StackPanel>
     <StackPanel Spacing="7" IsVisible="{Binding IsCustom}"><TextBlock Text="接口地址" Classes="web-label"/><TextBox Text="{Binding Settings.CurrentAi.Domain}" PlaceholderText="https://api.example.com/v1"/></StackPanel>
     <StackPanel Spacing="7"><TextBlock Text="API Key" Classes="web-label"/><TextBox Text="{Binding Settings.CurrentAi.ApiKey}" PasswordChar="●" PlaceholderText="输入服务商提供的 API Key"/></StackPanel>
     <StackPanel Spacing="7"><TextBlock Text="模型名称" Classes="web-label"/><TextBox Text="{Binding Settings.CurrentAi.ModelName}" PlaceholderText="例如：deepseek-chat"/></StackPanel>
     <Border Height="1" Background="{DynamicResource WebBorder}"/>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><TextBlock Text="API Key 仅保存在本机配置中" Classes="web-muted" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="web primary" Content="检测连通" Command="{Binding TestApiConnectionCommand}" IsEnabled="{Binding !IsTestingConnection}"/></Grid>
     <TextBlock Text="正在检测连接…" IsVisible="{Binding IsTestingConnection}" Classes="web-muted"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Classes="panel"><Grid ColumnDefinitions="230,*" ColumnSpacing="40"><StackPanel Spacing="9"><TextBlock Text="答题方式" Classes="web-section"/><TextBlock Text="执行策略位于工作台的策略页签。" Classes="web-muted"/></StackPanel><StackPanel Grid.Column="1" Spacing="10"><TextBlock Text="自动答题使用这里配置的模型；文字识别由 Pix2Text 完成。" Classes="web-muted"/><TextBlock Text="随机答题不依赖 AI 模型。验证码和二次验证仍需手动完成。" Classes="web-muted"/></StackPanel></Grid></Border>
 </StackPanel></ScrollViewer>
</UserControl>