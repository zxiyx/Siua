<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Siua.ViewModels" xmlns:co="using:Siua.Common" xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
 x:Class="Siua.Views.Pages.LogView" x:DataType="vm:LogViewModel">
 <UserControl.Resources><co:LogLevelToColorConverter x:Key="LevelColor"/></UserControl.Resources>
 <Grid Margin="28,24" RowDefinitions="Auto,*" RowSpacing="24">
  <StackPanel Spacing="6"><TextBlock Text="运行日志" Classes="web-title"/><TextBlock Text="追踪任务执行过程，按课程任务和日志等级筛选。" Classes="web-muted"/></StackPanel>
  <Border Grid.Row="1" Classes="panel" Padding="0">
   <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="18" Margin="20,16">
     <ComboBox ItemsSource="{Binding TaskFilters}" SelectedItem="{Binding SelectedTaskFilter}" HorizontalAlignment="Stretch"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center"><CheckBox Content="提示" IsChecked="{Binding ShowInfo}"/><CheckBox Content="报错" IsChecked="{Binding ShowError}"/><CheckBox Content="浏览器" IsChecked="{Binding ShowBrowser}"/></StackPanel>
     <Button Grid.Column="2" Classes="web" Content="清空日志" Command="{Binding ClearLogsCommand}"/>
    </Grid>
    <Border Grid.Row="1" Padding="20,11" Background="{DynamicResource WebCanvas}" BorderBrush="{DynamicResource WebBorder}" BorderThickness="0,1"><Grid ColumnDefinitions="80,64,88,*" ColumnSpacing="10"><TextBlock Text="时间" Classes="web-label"/><TextBlock Grid.Column="1" Text="等级" Classes="web-label"/><TextBlock Grid.Column="2" Text="来源" Classes="web-label"/><TextBlock Grid.Column="3" Text="详细信息" Classes="web-label"/></Grid></Border>
    <Grid Grid.Row="2">
     <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate x:DataType="co:LogEntry">
       <Grid ColumnDefinitions="80,64,88,*" ColumnSpacing="10" Margin="4,5">
        <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" Classes="web-muted" FontFamily="Consolas"/>
        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="{Binding Level, Converter={StaticResource LevelColor}}" FontSize="12"/>
        <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="web-muted" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" Text="{Binding DisplayMessage}" TextWrapping="Wrap" FontSize="12" LineHeight="20"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel IsVisible="{Binding !Logs.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsHitTestVisible="False"><icons:MaterialIcon Kind="TextBoxOutline" Width="32" Height="32" Foreground="{DynamicResource WebMuted}" HorizontalAlignment="Center"/><TextBlock Text="暂无匹配的日志" Classes="web-section" HorizontalAlignment="Center"/><TextBlock Text="启动任务后，运行信息会显示在这里。" Classes="web-muted"/></StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>