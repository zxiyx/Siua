<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Siua.ViewModels" xmlns:suki="https://github.com/kikipoulet/SukiUI"
 xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
 x:Class="Siua.Views.Pages.CourseEditView" x:DataType="vm:CourseEditViewModel">
 <Grid Margin="28,24" RowDefinitions="Auto,Auto,*" RowSpacing="24">
  <Grid ColumnDefinitions="*,160" ColumnSpacing="20"><StackPanel Spacing="6"><TextBlock Text="课程管理" Classes="web-title"/><TextBlock Text="集中维护课程链接，在工作台选择需要执行的课程。" Classes="web-muted"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Settings.CurrentPlatform}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Grid>
  <Border Grid.Row="1" Classes="panel">
   <suki:BusyArea IsBusy="{Binding IsSaving}"><StackPanel Spacing="12"><TextBlock Text="添加课程" Classes="web-section"/>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBox Text="{Binding NewCourse}" PlaceholderText="粘贴进入课程后的完整地址：https://..."/><Button Grid.Column="1" Classes="web primary" Content="＋  添加课程" Command="{Binding AddCourseCommand}"/></Grid>
    <TextBlock Text="{Binding CourseValidationMessage}" Classes="web-muted"/>
   </StackPanel></suki:BusyArea>
  </Border>
  <Border Grid.Row="2" Classes="panel" Padding="0">
   <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="{DynamicResource WebBorder}" BorderThickness="0,0,0,1" Padding="20,16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="课程链接" Classes="web-section"/><TextBlock Grid.Column="1" Classes="web-muted"><Run Text="共 "/><Run Text="{Binding Settings.Courses.Count}"/><Run Text=" 门课程"/></TextBlock></Grid></Border>
    <Grid Grid.Row="1" Margin="12">
     <ListBox ItemsSource="{Binding Settings.Courses}" SelectedItem="{Binding SelectedCourse}" Classes="web-nav">
      <ListBox.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnDefinitions="24,*" ColumnSpacing="12"><icons:MaterialIcon Kind="LinkVariant" Width="18" Height="18" Foreground="{DynamicResource WebMuted}"/><TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel IsVisible="{Binding !Settings.Courses.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"><icons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="32" Height="32" Foreground="{DynamicResource WebMuted}" HorizontalAlignment="Center"/><TextBlock Text="还没有课程链接" Classes="web-section" HorizontalAlignment="Center"/><TextBlock Text="在上方粘贴课程地址，添加你的第一门课程。" Classes="web-muted"/></StackPanel>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource WebBorder}" BorderThickness="0,1,0,0" Padding="20,12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="请使用课程页面地址，不要填写平台首页或登录页。" Classes="web-muted" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="web danger" Content="删除选中" Command="{Binding RemoveCourseCommand}"/></Grid></Border>
   </Grid>
  </Border>
 </Grid>
</UserControl>